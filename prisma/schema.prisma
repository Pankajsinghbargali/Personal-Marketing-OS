generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Platform {
  META
  GOOGLE
  LINKEDIN
  YOUTUBE
  INSTAGRAM
}

enum LeadStage {
  COLD
  WARM
  HOT
  SITE_VISIT
  CLOSED
  LOST
}

enum ContentStatus {
  DRAFT
  SCHEDULED
  POSTED
}

model User {
  id            String   @id @default(cuid())
  name          String?
  email         String   @unique
  passwordHash  String?
  role          String   @default("admin")
  accounts      Account[]
  sessions      Session[]
  createdAt     DateTime @default(now())
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Idea {
  id             String   @id @default(cuid())
  title          String
  notes          String?
  tags           String[]
  priority       String   @default("medium")
  status         String   @default("new")
  linkedCampaign String?
  createdAt      DateTime @default(now())
}

model Campaign {
  id          String    @id @default(cuid())
  name        String
  platform    Platform
  objective   String
  budget      Float
  startDate   DateTime
  endDate     DateTime
  funnelStage String
  creatives   String?
  notes       String?
  learnings   String?
  spend       Float     @default(0)
  impressions Int       @default(0)
  ctr         Float     @default(0)
  cpc         Float     @default(0)
  leads       Int       @default(0)
  roas        Float     @default(0)
  createdAt   DateTime  @default(now())
}

model ContentItem {
  id          String        @id @default(cuid())
  title       String
  platform    Platform
  contentType String
  funnelStage String
  status      ContentStatus @default(DRAFT)
  hook        String?
  caption     String?
  script      String?
  shootDate   DateTime?
  publishDate DateTime?
  views       Int           @default(0)
  saves       Int           @default(0)
  leads       Int           @default(0)
  createdAt   DateTime      @default(now())
}

model Lead {
  id           String    @id @default(cuid())
  name         String
  phone        String?
  email        String?
  source       String
  assignedTo   String?
  followUpDate DateTime?
  notes        String?
  dealValue    Float     @default(0)
  stage        LeadStage @default(COLD)
  callLog      String?
  createdAt    DateTime  @default(now())
}

model IntegrationCredential {
  id           String   @id @default(cuid())
  provider     String
  encryptedKey String
  refreshToken String?
  expiresAt    DateTime?
  createdAt    DateTime @default(now())
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
