generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  admin
  editor
  viewer
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String?
  name         String?
  role         Role     @default(editor)
  googleId     String?  @unique
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Campaign {
  id           String   @id @default(cuid())
  name         String
  platform     String
  objective    String
  budget       Decimal
  startDate    DateTime
  endDate      DateTime?
  funnelStage  String
  adCreatives  Json?
  notes        String?
  performance  Json?
  learningsLog String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Idea {
  id             String   @id @default(cuid())
  title          String
  notes          String?
  tags           String[]
  priority       String
  status         String
  linkedCampaign String?
  createdAt      DateTime @default(now())
}

model Lead {
  id           String   @id @default(cuid())
  name         String
  phone        String?
  email        String?
  source       String
  stage        String
  assignedTo   String?
  followUpDate DateTime?
  notes        String?
  dealValue    Decimal? @default(0)
  createdAt    DateTime @default(now())
}

model IntegrationCredential {
  id           String   @id @default(cuid())
  service      String
  accessToken  String
  refreshToken String?
  expiresAt    DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
